<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.frostnova.aigateway.credential.mapper.AppCredentialMapper">

    <resultMap id="appCredentialResultMap"
               type="org.frostnova.aigateway.credential.model.AppCredential">
        <id property="id" column="id"/>
        <result property="appId" column="app_id"/>
        <result property="appName" column="app_name"/>
        <result property="apiKeyHash" column="api_key_hash"/>
        <result property="status" column="status"/>
        <result property="rateLimitPerMinute" column="rate_limit_per_minute"/>
        <result property="dailyTokenQuota" column="daily_token_quota"/>
        <result property="allowedModels" column="allowed_models"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="credentialColumns">
        id,
        app_id,
        app_name,
        api_key_hash,
        status,
        rate_limit_per_minute,
        daily_token_quota,
        allowed_models,
        created_at,
        updated_at
    </sql>

    <insert id="insert"
            parameterType="org.frostnova.aigateway.credential.model.AppCredential"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO app_credential (
            app_id,
            app_name,
            api_key_hash,
            status,
            rate_limit_per_minute,
            daily_token_quota,
            allowed_models,
            created_at,
            updated_at
        ) VALUES (
            #{appId},
            #{appName},
            #{apiKeyHash},
            #{status},
            #{rateLimitPerMinute},
            #{dailyTokenQuota},
            #{allowedModels},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="findByAppId" resultMap="appCredentialResultMap">
        SELECT
        <include refid="credentialColumns"/>
        FROM app_credential
        WHERE app_id = #{appId}
    </select>

    <select id="findActiveByApiKeyHash" resultMap="appCredentialResultMap">
        SELECT
        <include refid="credentialColumns"/>
        FROM app_credential
        WHERE api_key_hash = #{apiKeyHash}
          AND status = 'ACTIVE'
    </select>

    <update id="updateStatus">
        UPDATE app_credential
        SET status = #{status},
            updated_at = CURRENT_TIMESTAMP(3)
        WHERE app_id = #{appId}
    </update>

</mapper>
